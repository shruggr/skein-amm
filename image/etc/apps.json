    {
      "transport": "http",
      "address": "/lookup",
      "filters": [
        "amm.lookup"
      ]
    },
    {
      "transport": "http",
      "address": "/",
      "prefix": true,
      "filters": [
        "amm.page"
      ],
      "root": "www",
      "index": "index.html"
    }
  ]
}
