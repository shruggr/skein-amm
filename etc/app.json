            "id": "string",
            "status": "string",
            "funding": "bytes",
            "add": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string",
            "poolState?": "map"
          }
        },
        "status": {
          "writes": false,
          "args": {
            "id": "string"
