            "swap": "bytes",
            "pool": "string",
            "validator": "bytes",
            "peerId": "string",
            "expires": "ms"
          },
          "answer": {
            "id": "string",
            "status": "string",
            "funding": "bytes",
            "swap": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string",
            "poolState?": "map"
          }
        },
        "status": {
          "writes": false,
          "args": {
            "id": "string"
          },
          "answer": {
            "id": "string",
            "status": "string",
            "funding": "bytes",
            "swap": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string",
            "poolState?": "map"
          }
        },
        "terms": {
          "writes": false,
          "args": {},
