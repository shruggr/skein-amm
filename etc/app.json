    {
      "interface": "amm.swap/1",
      "functions": {
        "submit": {
          "writes": true,
          "args": {
            "funding": "bytes",
            "swap": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms"
          },
          "answer": {
            "id": "string",
            "status": "string",
            "funding": "bytes",
            "swap": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string",
            "poolState?": "map"
          }
        },
        "status": {
          "writes": false,
          "args": {
            "id": "string"
          },
          "answer": {
            "id": "string",
            "status": "string",
            "funding": "bytes",
            "swap": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string",
            "poolState?": "map"
          }
        },
        "terms": {
          "writes": false,
          "args": {},
          "answer": {
            "commissionPkh?": "bytes"
          }
        }
      }
    },
    {
      "interface": "amm.pool/1",
      "functions": {
        "submit": {
          "writes": true,
          "args": {
            "funding": "bytes",
            "deploy": "bytes",
            "validator": "bytes",
            "expires": "ms"
          },
          "answer": {
            "id": "string",
            "status": "string",
            "funding": "bytes",
            "deploy": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string"
          }
        },
        "status": {
          "writes": false,
          "args": {
            "id": "string"
          },
          "answer": {
            "id": "string",
            "status": "string",
            "funding": "bytes",
            "deploy": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string"
          }
        }
      }
    },
    {
      "interface": "amm.liquidity/1",
      "functions": {
        "submit": {
          "writes": true,
          "args": {
            "funding": "bytes",
            "add": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms"
          },
          "answer": {
            "id": "string",
            "status": "string",
            "funding": "bytes",
            "add": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string",
            "poolState?": "map"
          }
        },
        "status": {
          "writes": false,
          "args": {
            "id": "string"
          },
          "answer": {
            "id": "string",
            "status": "string",
            "funding": "bytes",
            "add": "bytes",
            "pool": "string",
            "validator": "bytes",
            "expires": "ms",
            "created": "ms",
            "updated": "ms",
            "tx?": "bytes",
            "txid?": "string",
            "reason?": "string",
            "detail?": "string",
            "poolState?": "map"
          }
        }
      }
    }
  ],
  "requires": [
    "chain/1"
  ],
  "dispatch": [
    {
      "address": "amm",
      "sender": "$owner",
      "program": "overlay"
    },
    {
      "address": "amm",
      "sender": "event",
      "program": "overlay"
    },
    {
      "address": "amm",
      "sender": "$self",
      "program": "overlay"
    },
    {
      "address": "amm",
      "sender": "*",
      "program": "amm-p2p"
    },
    {
      "address": "amm-p2p",
      "sender": "*",
      "program": "amm-p2p"
    },
    {
      "transport": "http",
      "address": "/listTopicManagers",
      "sender": "*",
      "program": "overlay",
      "fn": "listTopicManagers"
    },
    {
      "transport": "http",
      "address": "/listLookupServiceProviders",
      "sender": "*",
      "program": "overlay",
      "fn": "listLookupServiceProviders"
    },
    {
      "transport": "http",
      "address": "/getDocumentationForTopicManager",
      "sender": "*",
      "program": "overlay",
      "fn": "topicDocumentation"
    },
    {
      "transport": "http",
      "address": "/getDocumentationForLookupServiceProvider",
      "sender": "*",
      "program": "overlay",
      "fn": "lookupDocumentation"
    },
    {
      "transport": "http",
      "address": "/live",
      "sender": "*",
      "program": "amm-p2p",
      "fn": "live"
    },
    {
      "transport": "http",
      "address": "/call",
      "sender": "*",
      "program": "amm-p2p",
      "fn": "call"
    },
    {
      "transport": "libp2p",
      "address": "/amm/proofs/1.0.0",
      "sender": "*",
      "program": "amm-p2p",
      "fn": "proofsByBlock"
    },
    {
      "transport": "libp2p",
      "address": "/amm-validator/1/swap",
      "sender": "*",
      "program": "amm-validator",
      "fn": "swap"
    },
    {
      "transport": "libp2p",
      "address": "/amm-validator/1/addLiquidity",
      "sender": "*",
      "program": "amm-validator",
      "fn": "addLiquidity"
    },
    {
      "transport": "libp2p",
      "address": "/amm-validator/1/deploy",
      "sender": "*",
      "program": "amm-validator",
      "fn": "deploy"
    }
  ],
  "start": {
    "body": {
      "kind": "amm-p2p-start"
    }
  },
  "stop": {
    "body": {
      "kind": "amm-p2p-stop"
    }
  },
  "description": "An AMM over Mandala tokens (docs/AMM.md): the overlay engine (shruggr/skein-overlay 0.6.0, required: chain/1) with the Mandala components (shruggr/skein-mandala 0.4.0: the topic manager mandala-topic, one topic per token tm_<txid> and the discovery topic tm_mandala_deploys; the lookups ls_mandala and ls_mandala_deploys), the pool liquidity lookup ls_amm (amm-lookup, one service over every token topic, each query naming its token), the validator (amm-validator: swap, addLiquidity, deploy as libp2p direct calls) and amm-p2p: the validator liveness heartbeat, proofs by block (/amm/proofs/1.0.0) and the marketplace relay (amm.swap/1, amm.pool/1, amm.liquidity/1: a taker's or an LP's transaction carried to its validator). The manifest declares no topics: the owner registers each token topic with the engine, a message in box amm {fn: \"register\", args: {topic, program: \"mandala-topic\"}}, and drops it with {fn: \"deregister\", args: {topic}}."
}
