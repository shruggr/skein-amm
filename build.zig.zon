.{
    .name = .skein_amm,
    .version = "0.50.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x4bfa15430693c422,
    .dependencies = .{
        // The overlay engine (its bin/overlay.wasm is copied into bin/) and the topic and lookup
        // contracts; the SDK (chain, wallet, app, sk, cbor, dagjson, message) comes through it.
        .skein_overlay = .{
            .url = "https://github.com/shruggr/skein-overlay/archive/refs/tags/v0.27.0.tar.gz",
            .hash = "skein_overlay-0.27.0-IMuNgXLGJABc_LSANTOxq2KfzvDQqdeC8VVFlM6NbNkI",
        },
        // The 1Color components: the `1color` module (the BRC-162 / BRC-161 parsers, the BSV-21
        // rules, topic names) and the built bin/color-topic.wasm, bin/color-lookup.wasm, copied
        // into bin/. (Its pages, www/, are outside the package's paths: scripts/color-pages.sh
        // copies them from the same tag's tarball by URL and sha256.)
        // skein-sdk v0.20.0 for its signer client (lib/signer.zig: every signature and key through the
        // signer app by a kernel-checked name) and the named call (`sk.callAs`). The overlay's own SDK
        // (chain, cbor, …) comes through skein_overlay.
        .skein_sdk_signer = .{
            .url = "https://github.com/shruggr/skein-sdk/archive/refs/tags/v0.21.2.tar.gz",
            .hash = "skein_sdk-0.21.2-YroFBMdCHQAqF4yIwzs6dAYjEE8afJi5fGg1NQzMrbBS",
        },
        .skein_1color = .{
            .url = "https://github.com/shruggr/skein-1color/archive/refs/tags/v0.19.0.tar.gz",
            .hash = "skein_1color-0.19.0-_DlbUmZ8IgB4uNb6_wz_F8BPXYRdKfqybbCYuluCEjPG",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "programs",
        "test.zig",
        "bin",
        "etc",
        "docs",
        "README.md",
        "CHANGELOG.md",
    },
}
