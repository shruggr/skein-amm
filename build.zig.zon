.{
    .name = .skein_amm,
    .version = "0.14.0",
    .minimum_zig_version = "0.16.0",
    .fingerprint = 0x4bfa15430693c422,
    .dependencies = .{
        // The overlay engine (its bin/overlay.wasm is copied into bin/) and the topic and lookup
        // contracts; the SDK (chain, wallet, app, sk, cbor, dagjson, message) comes through it.
        .skein_overlay = .{
            .url = "https://github.com/shruggr/skein-overlay/archive/refs/tags/v0.15.0.tar.gz",
            .hash = "skein_overlay-0.15.0-IMuNgeIpIQBCCGrXNmwbz8m-p8b3qYplJs_0qIBls35y",
        },
        // The 1Color components: the `1color` module (the BRC-162 / BRC-161 parsers, the BSV-21
        // rules, topic names) and the built bin/color-topic.wasm, bin/color-lookup.wasm, copied
        // into bin/. (Its pages, www/, are outside the package's paths: scripts/color-pages.sh
        // copies them from the same tag's tarball by URL and sha256.)
        .skein_1color = .{
            .url = "https://github.com/shruggr/skein-1color/archive/refs/tags/v0.11.0.tar.gz",
            .hash = "skein_1color-0.11.0-_DlbUje6HgCS-HA2Vi935falNX8nffWHQ3dXmFqaLueA",
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "programs",
        "test.zig",
        "bin",
        "etc",
        "www",
        "docs",
        "README.md",
        "CHANGELOG.md",
    },
}
